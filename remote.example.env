# Copy to remote.env and fill in (remote.env is gitignored).
#
# Optional — GitHub search (playbook search.tokens; ~30 req/min each):
# GITHUB_TOKEN=
# GITHUB_TOKEN_2=
#
# Optional — OpenHat disclosure bot (truffles disclose -submit):
# OPENHAT_BOT_GH_TOKEN=
#   cp remote.example.env remote.env
# Or after create:
#   ./scripts/manage-gce-workers.sh PROJECT create --count 2
#   # script prompts to append into remote.env

# worker1
TRUFFLES_WORKER1_HOST=203.0.113.11
TRUFFLES_WORKER1_USER=ubuntu
TRUFFLES_WORKER1_KEY=${HOME}/.ssh/google_compute_engine
TRUFFLES_WORKER1_WORKDIR=/home/ubuntu/truffles-work
TRUFFLES_WORKER1_BIN=/usr/local/bin/truffles
TRUFFLES_WORKER1_GCE_INSTANCE=truffles-worker-1
TRUFFLES_WORKER1_GCE_ZONE=us-central1-a
TRUFFLES_WORKER1_GCE_PROJECT=sandbox420

# worker2
TRUFFLES_WORKER2_HOST=203.0.113.12
TRUFFLES_WORKER2_USER=ubuntu
TRUFFLES_WORKER2_KEY=${HOME}/.ssh/google_compute_engine
